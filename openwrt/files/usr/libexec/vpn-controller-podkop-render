#!/bin/ash
# SPDX-License-Identifier: MIT
# Calls installed Podkop functions; no upstream source is distributed here.
# The caller verifies hashes BEFORE this script sources any Podkop code.
set -e
[ "$#" = 3 ] || exit 2
stage="$1"; output="$2"; probes="$3"
# The pinned 0.7.23 and 0.7.24 script dispatch starts here. Strip dispatch, not functions.
sed '/^case "\$1" in/,$d' /usr/bin/podkop > "$stage/podkop-functions.sh"
. "$stage/podkop-functions.sh"
config_load "$stage/podkop"
# Render uses existing rule sets only. None of these functions may modify live
# rule sets or nft. Missing source files make the entire render fail.
create_source_rule_set() {
    [ -s "$1" ] || { touch "$stage/render.failed"; return 1; }
    return 0
}
patch_source_ruleset_rules() { :; }
import_plain_domain_list_to_local_source_ruleset_chunked() { :; }
import_plain_subnet_list_to_local_source_ruleset_chunked() { :; }
nft_list_all_traffic_from_ip() { :; }
nft_add_set_elements() { :; }
nft_add_set_elements_from_file_chunked() { :; }
sing_box_save_config() {
    local sid port
    while read -r sid port; do
        config="$(sing_box_cf_add_mixed_inbound_and_route_rule "$config" "vpn-controller-$sid" \
            "127.0.0.1" "$port" "$sid-out")"
    done < "$probes"
    sing_box_cm_save_config_to_file "$config" "$output"
}
sing_box_init_config
[ ! -e "$stage/render.failed" ]
[ -s "$output" ]
