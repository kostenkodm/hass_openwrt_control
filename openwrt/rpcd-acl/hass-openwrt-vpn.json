{
  "hass-openwrt-vpn": {
    "description": "Limited VPN controller API: section policies, diagnostics and history only",
    "read": {
      "ubus": {
        "vpn.controller": [
          "capabilities",
          "status",
          "sections",
          "vpns",
          "history",
          "operation"
        ]
      }
    },
    "write": {
      "ubus": {
        "vpn.controller": [
          "set_automation",
          "configure",
          "set_policy",
          "assign_vpn",
          "diagnose",
          "restart_vpn"
        ]
      }
    }
  }
}
